DATABASE_URI=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Application URLs
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com
NODE_ENV=development

# Fapshi Payment Gateway Configuration
FAPSHI_API_USER=your_fapshi_api_user
FAPSHI_API_KEY=your_fapshi_api_key
FAPSHI_WEBHOOK_URL=https://yourdomain.com/api/custom/payments/webhook/fapshi
FAPSHI_ENV_MODE=development

# Cron Job Security
CRON_SECRET=your_secure_cron_secret_for_automated_tasks

# Email (Resend)
RESEND_API_KEY=your_resend_api_key

# Google Gemini AI (get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Cloudflare R2 Storage (required in production)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=your_r2_bucket_name
R2_SUBDOMAIN=https://your_r2_subdomain.r2.dev
R2_TOKEN=your_r2_token
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_REGION=auto