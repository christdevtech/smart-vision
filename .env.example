DATABASE_URI=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 storage (required in production)
R2_BUCKET=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_REGION=auto

# Fapshi Payment Gateway Configuration
FAPSHI_API_USER=your_fapshi_api_user
FAPSHI_API_KEY=your_fapshi_api_key
FAPSHI_WEBHOOK_URL=https://yourdomain.com/api/custom/payments/webhook/fapshi

# Cron Job Security
CRON_SECRET=your_secure_cron_secret_for_automated_tasks

# Application URLs
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com
